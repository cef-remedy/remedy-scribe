# Remedy Scribe — production environment template (Phase 5.1, decision 0036)
#
# ⚠️ THIS FILE IS A TEMPLATE OF A SOPS DOCUMENT, NOT A CONFIG FILE.
#
# It contains placeholders and MUST NOT be filled in and left on disk. The
# workflow, which implements docs/runbooks/secrets-management.md §2-3
# rather than inventing something new:
#
#   1. cp production.env.example production.env
#   2. fill it in (see "generating a value" notes below)
#   3. sops --encrypt --age <RECIPIENT> production.env > production.enc.env
#   4. shred -u production.env          # the plaintext must not survive step 3
#   5. commit production.enc.env; NEVER commit production.env
#
# The deploy then reads it with `sops exec-env`, which puts these values in
# the *process environment* of the docker-compose invocation and nowhere
# else. infra/deploy.sh does exactly that. There is deliberately no
# `env_file:` in infra/docker-compose.prod.yml, because the secrets runbook
# names that as the one pattern that must not reach a server — a file on
# the host is a file anyone with the host can `cat`, and unlike a process
# environment it survives the process.
#
# infra/.env MUST NOT EXIST. Docker Compose auto-loads it for variable
# interpolation, which would silently reintroduce exactly the file this
# design removes. infra/deploy.sh refuses to run if it finds one.
#
# ---------------------------------------------------------------------
# BLOCKED ON LEGAL — read decision 0036 before filling these in
# ---------------------------------------------------------------------
# Every hostname below implies a jurisdiction, and data residency for
# Philippine health data is a question for Legal before it is a question
# for engineering. The three that carry PHI or key material are the
# managed Postgres, the object store, and the secret manager's own root
# key. Nothing here should be pointed at a region until Legal has answered.

# --- release ---------------------------------------------------------
# The git sha or tag being deployed. Tags the built images, so `docker
# images` and `docker ps` answer "what is actually running" without
# guessing. Set by infra/deploy.sh from the working tree, not from here.
# REMEDY_RELEASE=

# --- public identity -------------------------------------------------
# The one hostname. Same origin serves the PWA and proxies /api
# (apps/web/Dockerfile explains why), so this is also CORS_ALLOW_ORIGINS
# and the certificate's subject.
REMEDY_PUBLIC_DOMAIN=scribe.example.invalid
# Where Let's Encrypt sends expiry warnings. A distribution list, not a
# person who might change jobs.
ACME_EMAIL=ops@example.invalid

# --- managed Postgres ------------------------------------------------
# ⚠️ Two query parameters, both load-bearing:
#
# `sslmode=verify-full` — the 4.1-owed "TLS to Postgres" leg. Not
#   `require`, which encrypts without authenticating and so stops a
#   passive eavesdropper but not an active one. verify-full additionally
#   needs the provider's CA reachable to libpq: mount it into the api,
#   worker, beat and migrate containers and add
#   `&sslrootcert=/etc/ssl/certs/<provider>.crt`. `verify-full` with no
#   trusted CA fails closed, which is the right direction but will look
#   like an outage on first deploy — expect it and read the message.
#
# `connect_timeout=5` — bounds the readiness probe. Measured: with
#   Postgres unreachable the probe answers in ~2.0 s per resolved
#   address, and a hostname with both an A and a AAAA record pays it
#   twice (4.1 s), because libpq tries each in turn. Budget
#   connect_timeout x addresses against Caddy's 10 s health_timeout. The
#   case this actually protects against is not a refused connection —
#   that is already fast — but a host that accepts the SYN and never
#   completes the handshake, which is unbounded without it.
#
# The password is inline in this URL, which is why the whole file is a
# sops document rather than only the obvious secrets.
DATABASE_URL=postgresql+psycopg://remedy_app:CHANGE_ME@db.CHANGE_ME:5432/remedy_scribe?sslmode=verify-full&connect_timeout=5

# --- Redis -----------------------------------------------------------
# Not set here. infra/docker-compose.prod.yml pins REDIS_URL to the
# self-hosted container on the internal network, and the data-loss window
# that choice accepts is argued out in full in that file's `redis`
# service. Moving Redis off the VM means setting REDIS_URL here with a
# `rediss://` scheme — and re-reading that argument, because it stops
# applying the moment the connection leaves the host.

# --- object storage (PROVIDER BLOCKED ON LEGAL) ----------------------
# Consultation audio. The most sensitive artifact in the system: verbatim
# recordings, and the retention clock is enforced partly by the bucket's
# own lifecycle rule (decision 0033), so the provider must actually
# support lifecycle expiration and server-side encryption — decision 0014
# records a MinIO version that accepted a lifecycle PUT and did not echo
# the abort action back, which is exactly the class of silent gap to test
# for before the pilot.
#
# https:// is not optional whatever the provider turns out to be: this is
# where the audio travels.
S3_ENDPOINT_URL=https://s3.CHANGE_ME
# The origin a *browser* fetches presigned audio from. Usually the same
# host as S3_ENDPOINT_URL, but not always (a CDN or a path-style vs
# virtual-hosted difference), and it goes into the page's CSP
# `media-src`/`connect-src` — so getting it wrong means playback is
# blocked by the browser with only a console message to show for it.
S3_PUBLIC_ORIGIN=https://s3.CHANGE_ME
S3_BUCKET=remedy-scribe-audio
S3_ACCESS_KEY=CHANGE_ME
# Rotate at the object store, not here — this is a copy of a credential
# that lives there.
S3_SECRET_KEY=CHANGE_ME

# --- the secret whose LOSS is as bad as its leak ---------------------
# Generate one per environment, and never by copying another environment's:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ⚠️ Before this value is ever used to encrypt a single row, it must exist
# in a second place that does not depend on this deployment — two offline
# copies, two different people. Losing it makes every encrypted column
# permanently unreadable, and under the Data Privacy Act that is a
# reportable availability incident, not an outage. See
# docs/runbooks/key-rotation.md.
#
# The app refuses to boot in production holding the key published in
# apps/api/.env.example. That guard is a backstop for a mistake, not the
# control — the control is that the production age key is not on a laptop.
PHI_ENCRYPTION_KEY=CHANGE_ME

# Empty except during a rotation. Set it, deploy, run
# scripts/rotate_phi_key.py, verify, then clear it and deploy again. A
# retired key still listed is a retired key still able to read PHI.
PHI_ENCRYPTION_KEY_PREVIOUS=

# --- auth ------------------------------------------------------------
# Rotating this invalidates every access token at once, which is why it is
# also the first step of breach response (docs/runbooks/breach-response.md).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME

# --- vendor ----------------------------------------------------------
# ⚠️ THE PAID TIER. Groq's BAA covers "Covered Cloud Services", a
# definition that explicitly excludes services "provided for free or at no
# additional charge" — so the free tier is precisely the tier carrying no
# data-protection undertaking, and this system sends it both the audio and
# the transcript (decisions 0018, 0035). A free-tier key here is a
# compliance failure that works perfectly.
GROQ_API_KEY=CHANGE_ME
NOTE_GENERATOR_PROVIDER=groq

# --- compliance: Legal's numbers, not engineering's ------------------
# How long consultation audio is kept. Enforced in two layers (decision
# 0033): the bucket lifecycle rule and the hourly Beat sweep.
AUDIO_RETENTION_DAYS=90
# Deliberately far longer: "who accessed this record?" is asked after the
# record itself is gone. 2555 = seven years, matching the usual
# medical-record horizon. The actual figure is Legal's.
AUDIT_LOG_RETENTION_DAYS=2555

# --- deliberately NOT set here ---------------------------------------
# ENVIRONMENT, REFRESH_COOKIE_SECURE, REFRESH_COOKIE_SAMESITE and
# CORS_ALLOW_ORIGINS are fixed in infra/docker-compose.prod.yml rather
# than being settable from this file. They are not configuration for this
# environment — they are what *makes* it a production environment, and
# three of them are things Phase 4.1's boot guard refuses to start
# without. Leaving them here would let a deploy weaken them by editing a
# value.
