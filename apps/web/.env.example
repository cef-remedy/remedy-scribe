# Base URL of the Remedy Scribe API. Must be an origin listed in the API's
# CORS_ALLOW_ORIGINS, and vice versa — a mismatch blocks every request in
# the browser before it reaches a route, with nothing in the API log.
VITE_API_BASE_URL=http://localhost:8000

# Optional, dev-only (src/routes/Login.tsx, src/lib/totp.ts). Set this to a
# seeded account's MFA secret (e.g. the one scripts/seed_staging.py prints)
# to skip typing an authenticator code during local development or a demo
# recording — the code is computed in the browser instead of on a phone.
# Only ever read under `import.meta.env.DEV`: a production build always
# shows the real field, unaffected by this. Leave unset for normal use.
# VITE_DEMO_MFA_SECRET=
