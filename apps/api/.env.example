# Copy to .env for local development. Values here match infra/docker-compose.yml.

ENVIRONMENT=development

# --- Postgres ---
# Host ports are offset by one from the service defaults (5433/6380/9002-3)
# because infra/docker-compose.yml maps them that way — on at least one dev
# machine a native Postgres/Redis install already owned the standard ports
# and silently ate Docker's forwarded traffic. If nothing else on your
# machine holds 5432/6379/9000-1, feel free to run docker-compose with the
# standard ports instead; just keep this file in sync with whatever
# infra/docker-compose.yml actually publishes.
DATABASE_URL=postgresql+psycopg://remedy:remedy@localhost:5433/remedy_scribe

# --- Redis (Celery broker + cache) ---
REDIS_URL=redis://localhost:6380/0

# --- Object storage (MinIO locally, S3-compatible bucket in prod) ---
S3_ENDPOINT_URL=http://localhost:9002
# Only needed when this server's own view of storage differs from what a
# browser can reach — running via `docker compose`, where the API talks to
# MinIO as `minio` (Docker-internal DNS) but a presigned URL handed to the
# browser has to say `localhost:9002` instead. Unset here on purpose: this
# .env is for running the API directly on the host (docs/runbooks/local-
# development.md's `uvicorn` path), where both are already the same
# address and a second one would just be one more thing to keep in sync.
# infra/docker-compose.yml sets S3_PUBLIC_ENDPOINT_URL itself for the
# containerized path — see its own comment for the failure this fixes
# (net::ERR_NAME_NOT_RESOLVED on every upload, found live via Playwright).
# S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=remedy-scribe-audio
# MinIO ignores this. Real providers do not: use your Supabase project's
# region, "auto" for Cloudflare R2, or the bucket's region on AWS.
S3_REGION=us-east-1
S3_ACCESS_KEY=remedy
S3_SECRET_KEY=remedy-dev-secret

# --- Auth ---
JWT_SECRET=change-me-in-every-environment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# P0-8 calls for MFA, and `true` is the code default for a reason — this
# exists to defer it for the free-tier demo (no phone in hand, self-service
# accounts with no enrollment path yet), not to turn it off silently. Set
# to `false` for local development: with the default `true`, a self-
# registered account (POST /auth/register) can never log in, because it
# has no mfa_secret and login requires one when this is true. See
# app/core/config.py's own comment on `require_mfa` for the full story.
REQUIRE_MFA=true

# --- Field-level PHI encryption (see app/core/security.py:EncryptedString) ---
#
# This key is PUBLISHED ON PURPOSE (Phase 4.1, decision 0031). It is a real,
# working Fernet key for local development and nothing else: the app refuses
# to start with ENVIRONMENT=production while holding it, because a key
# committed to a repository cannot protect anything. Publishing it is what
# makes 4.1's "production keys never on a developer machine" enforceable —
# a known-bad value can be denied by value, and nobody needs to copy the
# real key down to get a working laptop.
#
# For any real environment, generate a fresh one per environment with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# and put it wherever that environment keeps its secrets — never here.
PHI_ENCRYPTION_KEY=jy8XzNfhCgDamDDLM0DAGmlpYmLKFQNpt6XLt402fyw=

# Decrypt-only keys, comma-separated, most recent first. Set during a key
# rotation and cleared once scripts/rotate_phi_key.py --verify-only reports
# zero failures under the new key alone. Full procedure:
# docs/runbooks/key-rotation.md.
PHI_ENCRYPTION_KEY_PREVIOUS=

# --- Transit security (Phase 4.1). TLS itself terminates in front of the
# app (Phase 5); these are the headers the app emits for itself. HSTS is
# sent only over https or in production — never over plain-http localhost,
# where a browser would pin localhost to https across every port. ---
HSTS_MAX_AGE_SECONDS=63072000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=false
# Must be true in production; the app refuses to start otherwise.
REFRESH_COOKIE_SECURE=false

# --- Note generation provider: "haiku" is the only option (2026-08-25 planning
# update, decision 0021 — supersedes PRD P0-4's original "Luna primary, Haiku
# configured fallback"; Luna/OPENAI_API_KEY are dropped, not kept dormant) ---
NOTE_GENERATOR_PROVIDER=haiku
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
NOTE_GENERATION_LOW_CONFIDENCE_THRESHOLD=0.5

# --- ASR provider: Groq-hosted Whisper large-v3 (Phase 1.3) ---
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3

# --- Compliance: audio retention (days). Configurable, not hardcoded (PRD Compliance story). ---
AUDIO_RETENTION_DAYS=90
# Much longer than PHI retention on purpose (Phase 4.2): "who accessed this?"
# is asked after the record is gone. Legal owns the real number.
AUDIT_LOG_RETENTION_DAYS=2555

# --- Pipeline failure handling (Phase 1.5): how long an encounter can sit in
# a non-terminal pipeline_status before sweep_stuck_encounters re-kicks it ---
PIPELINE_STUCK_THRESHOLD_MINUTES=30
